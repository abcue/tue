{
  "data": {
    "tencentcloud_private_dns_private_zone_list": {
      "rsc_id": {
        "filters": {
          "name": "Domain",
          "values": "${[local.rsc_id_domain]}"
        }
      }
    },
    "tencentcloud_private_dns_records": {
      "rsc_id": {
        "zone_id": "${local.rsc_id_zone_id}"
      }
    },
    "tencentcloud_user_info": {
      "current": {}
    }
  },
  "locals": {
    "app_id": "${data.tencentcloud_user_info.current.app_id}",
    "rsc_id": "${{ for r in data.tencentcloud_private_dns_records.rsc_id.record_set : r.sub_domain => r.record_value }}",
    "rsc_id_domain": "id.default.doma.in",
    "rsc_id_zone_id": "${local.rsc_id_zones[local.rsc_id_domain].zone_id}",
    "rsc_id_zones": "${{ for z in data.tencentcloud_private_dns_private_zone_list.rsc_id.private_zone_set : z.domain => z }}",
    "subnet_id": "${local.rsc_id[\"default.subnet\"]}",
    "vpc_id": "${local.rsc_id[\"default.vpc\"]}"
  },
  "resource": {
    "tencentcloud_instance": {
      "boilerplate": {
        "allocate_public_ip": false,
        "availability_zone": "ap-guangzhou-1",
        "disable_api_termination": true,
        "image_id": "img-m07ny34j",
        "instance_charge_type": "PREPAID",
        "instance_charge_type_prepaid_period": 1,
        "instance_charge_type_prepaid_renew_flag": "NOTIFY_AND_AUTO_RENEW",
        "instance_name": "boilerplate",
        "instance_type": "SA5.MEDIUM2",
        "orderly_security_groups": [
          "${tencentcloud_security_group.cvm_boilerplate.id}"
        ],
        "subnet_id": "${local.rsc_id[\"default.subnet\"]}",
        "system_disk_size": 50,
        "system_disk_type": "CLOUD_BSSD",
        "tags": {},
        "vpc_id": "${local.rsc_id[\"default.vpc\"]}"
      }
    },
    "tencentcloud_private_dns_record": {
      "cvm_boilerplate_A": {
        "record_type": "A",
        "record_value": "${tencentcloud_instance.boilerplate.private_ip}",
        "sub_domain": "${tencentcloud_instance.boilerplate.id}",
        "ttl": 300,
        "zone_id": "${local.rsc_id[\"cvm.default.doma.in.dns_zone\"]}"
      },
      "cvm_boilerplate_CNAME": {
        "record_type": "CNAME",
        "record_value": "${tencentcloud_instance.boilerplate.id}.cvm.default.doma.in",
        "sub_domain": "boilerplate",
        "ttl": 300,
        "zone_id": "${local.rsc_id[\"cvm.default.doma.in.dns_zone\"]}"
      }
    },
    "tencentcloud_security_group": {
      "cvm_boilerplate": {
        "name": "cvm_boilerplate"
      }
    },
    "tencentcloud_security_group_rule_set": {
      "cvm_boilerplate": {
        "egress": [
          {
            "action": "ACCEPT",
            "cidr_block": "0.0.0.0/0",
            "port": "ALL",
            "protocol": "ALL"
          }
        ],
        "ingress": [
          {
            "action": "ACCEPT",
            "address_template_id": "${local.rsc_id[\"ipm1.ipm\"]}",
            "description": "ssh",
            "port": "22",
            "protocol": "TCP"
          },
          {
            "action": "ACCEPT",
            "address_template_id": "${local.rsc_id[\"ipm1.ipm\"]}",
            "description": "Remote Desktop Protocol",
            "port": "3389",
            "protocol": "TCP"
          },
          {
            "action": "ACCEPT",
            "address_template_id": "${local.rsc_id[\"ipm2.ipm\"]}",
            "description": "Remote Desktop Protocol",
            "port": "3389",
            "protocol": "TCP"
          },
          {
            "action": "ACCEPT",
            "address_template_id": "${local.rsc_id[\"ipm1.ipm\"]}",
            "description": "Remote Desktop Protocol",
            "port": "3389",
            "protocol": "UDP"
          },
          {
            "action": "ACCEPT",
            "address_template_id": "${local.rsc_id[\"ipm2.ipm\"]}",
            "description": "Remote Desktop Protocol",
            "port": "3389",
            "protocol": "UDP"
          }
        ],
        "security_group_id": "${tencentcloud_security_group.cvm_boilerplate.id}"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "tencentcloud": {
        "source": "tencentcloudstack/tencentcloud"
      }
    }
  }
}
