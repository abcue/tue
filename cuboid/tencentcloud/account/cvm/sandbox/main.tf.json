{
  "data": {
    "tencentcloud_instance_types": {
      "sandbox": {
        "cpu_core_count": 1,
        "exclude_sold_out": true,
        "filter": [
          {
            "name": "instance-family",
            "values": [
              "SA5"
            ]
          },
          {
            "name": "zone",
            "values": [
              "ap-guangzhou-1"
            ]
          }
        ],
        "memory_size": 2
      }
    },
    "tencentcloud_private_dns_private_zone_list": {
      "rsc_id": {
        "filters": {
          "name": "Domain",
          "values": "${[local.rsc_id_domain]}"
        }
      }
    },
    "tencentcloud_private_dns_records": {
      "rsc_id": {
        "zone_id": "${local.zone_id}"
      }
    },
    "tencentcloud_user_info": {
      "current": {}
    }
  },
  "locals": {
    "app_id": "${data.tencentcloud_user_info.current.app_id}",
    "rsc_id": "${{ for r in data.tencentcloud_private_dns_records.rsc_id.record_set : r.sub_domain => r.record_value }}",
    "rsc_id_domain": "id.default.doma.in",
    "rsc_id_zone_id": "${local.rsc_id_zones[local.rsc_id_domain].zone_id}",
    "rsc_id_zones": "${{ for z in data.tencentcloud_private_dns_private_zone_list.rsc_id.private_zone_set : z.domain => z }}",
    "subnet_id": "${local.rsc_id[\"default.subnet\"]}",
    "vpc_id": "${local.rsc_id[\"default.vpc\"]}"
  },
  "output": {
    "sandbox": {
      "value": {
        "public_ip": "${tencentcloud_eip.sandbox[0].public_ip}"
      }
    }
  },
  "resource": {
    "tencentcloud_eip": {
      "sandbox": {
        "count": 1,
        "internet_charge_type": "TRAFFIC_POSTPAID_BY_HOUR",
        "internet_max_bandwidth_out": 10,
        "name": "sandbox",
        "tags": {},
        "type": "EIP"
      }
    },
    "tencentcloud_eip_association": {
      "sandbox": {
        "count": 1,
        "eip_id": "${tencentcloud_eip.sandbox[0].id}",
        "instance_id": "${tencentcloud_instance.sandbox.id}"
      }
    },
    "tencentcloud_instance": {
      "sandbox": {
        "allocate_public_ip": false,
        "availability_zone": "ap-guangzhou-1",
        "disable_api_termination": true,
        "image_id": "img-eb30mz89",
        "instance_charge_type": "PREPAID",
        "instance_charge_type_prepaid_period": 1,
        "instance_charge_type_prepaid_renew_flag": "NOTIFY_AND_AUTO_RENEW",
        "instance_name": "sandbox",
        "instance_type": "${data.tencentcloud_instance_types.sandbox.instance_types.0.instance_type}",
        "orderly_security_groups": [
          "${tencentcloud_security_group.sandbox.id}"
        ],
        "subnet_id": "${local.rsc_id[\"default.subnet\"]}",
        "system_disk_size": 50,
        "system_disk_type": "CLOUD_BSSD",
        "tags": {},
        "vpc_id": "${local.rsc_id[\"default.vpc\"]}"
      }
    },
    "tencentcloud_security_group": {
      "sandbox": {
        "name": "cvm-sandbox"
      }
    },
    "tencentcloud_security_group_rule_set": {
      "sandbox": {
        "egress": [
          {
            "action": "ACCEPT",
            "cidr_block": "0.0.0.0/0",
            "port": "ALL",
            "protocol": "ALL"
          }
        ],
        "ingress": [],
        "security_group_id": "${tencentcloud_security_group.sandbox.id}"
      }
    }
  }
}
